<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="800" prefWidth="1200" styleClass="chat-root" stylesheets="@chat.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sophia.ChatController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="header">
            <Label styleClass="header-icon" text="✧" />
            <Label styleClass="header-title" text="SophIA" />

            <Region HBox.hgrow="ALWAYS" />

            <Label styleClass="header-strategy-label" text="Estratégia" />
            <ComboBox fx:id="plannerCombo" styleClass="planner-combo" />
        </HBox>
    </top>

    <center>
        <StackPane styleClass="chat-area">
            <Label mouseTransparent="true" styleClass="watermark" text="SophIA" />

            <ScrollPane fx:id="chatScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="chat-scroll" vbarPolicy="AS_NEEDED">

                <content>
                    <VBox fx:id="messagesBox" fillWidth="true" spacing="28" styleClass="messages-container">

                        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="message-row">
                            <Label styleClass="assistant-icon" text="●" />
                            <VBox spacing="8">
                                <Label maxWidth="520" styleClass="assistant-message" text="Olá! Eu sou a SophIA. Me diga o tipo de livro que você procura — um gênero, um tema, um autor — que eu recomendo opções do catálogo." wrapText="true" />
                            </VBox>
                        </HBox>

                    </VBox>
                </content>
            </ScrollPane>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="16" styleClass="input-area">
            <TextField fx:id="messageField" onAction="#sendMessage" promptText="Digite sua mensagem..." styleClass="message-input" HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" styleClass="send-button-container">
                <StackPane styleClass="send-button-hitbox">
                    <javafx.scene.control.Button accessibleText="Enviar mensagem" onAction="#sendMessage" styleClass="send-button" />
                   <Label styleClass="send-button-icon" text="➤" />
                </StackPane>
            </HBox>
        </HBox>
    </bottom>

</BorderPane>
